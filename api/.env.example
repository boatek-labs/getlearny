NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://getlearny:getlearny@localhost:5432/getlearny
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=7d
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
OPENROUTER_API_KEY=sk-or-v1-replace-with-your-key
OPENROUTER_MODEL=google/gemma-4-31b-it:free
OPENROUTER_FALLBACK_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,openrouter/free
OPENROUTER_SITE_URL=https://getlearny.vercel.app
OPENROUTER_APP_NAME=GetLearny
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=12

# Web Push (generate VAPID keys; never commit private key)
VAPID_PUBLIC_KEY=replace-with-vapid-public-key
VAPID_PRIVATE_KEY=replace-with-vapid-private-key
VAPID_SUBJECT=mailto:admin@example.com
CRON_SECRET=replace-with-a-long-random-secret
