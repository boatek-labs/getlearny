NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://getlearny:getlearny@localhost:5432/getlearny
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=7d
# Resend email delivery for signup verification codes
RESEND_API_KEY=re_replace_with_resend_api_key
EMAIL_FROM=GetLearny <verify@your-verified-domain.com>
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=12

# Web Push (generate VAPID keys; never commit private key)
VAPID_PUBLIC_KEY=replace-with-vapid-public-key
VAPID_PRIVATE_KEY=replace-with-vapid-private-key
VAPID_SUBJECT=mailto:admin@example.com
CRON_SECRET=replace-with-a-long-random-secret
