{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "installCommand": "npm install --no-audit --no-fund",
  "buildCommand": "npm run build",
  "outputDirectory": "web",
  "rewrites": [
    { "source": "/api/v1/:path*", "destination": "/api/[...path]" }
  ],
  "functions": {
    "api/[...path].js": {
      "maxDuration": 30
    }
  }
}
